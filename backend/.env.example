# Copy this file to .env and fill in your values.
# NEVER commit .env — it is gitignored.

# Supabase
# Get from: https://supabase.com/dashboard → your project → Settings → API
SUPABASE_URL=
SUPABASE_SERVICE_KEY=    # Use the service_role key (not anon) — keep this secret

# App
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:3000

# ---- Week 3-4 (uncomment when ready) ----
# Visa API — https://developers.joinsherpa.com
# SHERPA_API_KEY=

# Amadeus — https://developers.amadeus.com
# AMADEUS_CLIENT_ID=
# AMADEUS_CLIENT_SECRET=

# ---- Week 5-6 (uncomment when ready) ----
# OpenAI — https://platform.openai.com/api-keys
# OPENAI_API_KEY=
